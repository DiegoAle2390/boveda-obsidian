{
  "permissions": {
    "allow": [
      "Read",
      "Write(**/*.md)",
      "Edit(**/*.md)",
      "Bash(git status)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git pull)",
      "Bash(git pull *)",
      "Bash(git push)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(.obsidian/**)",
      "Edit(.obsidian/**)"
    ]
  }
}